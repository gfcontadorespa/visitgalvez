# Telegram
# 1) Abre @BotFather en Telegram → /newbot (o /token para uno existente)
# 2) Pega el token aquí — NUNCA subas el valor real al repo
BOT_TOKEN=aqui-tu-bot-token-de-botfather

# Supabase (proyecto en supabase.com)
# Settings → API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co
# Service role key (solo server-side, NUNCA en frontend ni en el repo)
SUPABASE_SERVICE_ROLE_KEY=aqui-tu-service-role-key

# Panama default dial code (+507)
# Si usas psql local para el seed, deja esto vacío.
DATABASE_URL=
